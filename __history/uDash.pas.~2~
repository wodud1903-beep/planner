      '(완료하면 목록에서 사라집니다)',
      mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;
    if TGoogleTasksFetcher.CompleteTask(FGAuth, Gt.ListId, Gt.Id, Err) then
      FetchGoogleTasks
    else
      ShowMessage('구글 완료 처리 실패: ' + Err);
  end;
end;

